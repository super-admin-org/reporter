{
    "name": "super-admin-org/reporter",
    "description": "Exception reporter for laravel",
    "type": "library",
    "keywords": [
        "super-admin",
        "exception",
        "reporter"
    ],
    "homepage": "https://github.com/super-admin-org/reporter",
    "license": "MIT",
    "authors": [
        {
            "name": "sb | Super-Admin",
            "email": "info@super-admin.org"
        }
    ],
    "require": {
        "php": "^8.0",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "super-admin-org/super-admin": "^1.0",
        "ext-json": "*"
    },
    "require-dev": {
        "orchestra/testbench": "^6.0|^7.0|^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^9.5|^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "SuperAdmin\\Admin\\Reporter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SuperAdmin\\Admin\\Reporter\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SuperAdmin\\Admin\\Reporter\\ReporterServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
